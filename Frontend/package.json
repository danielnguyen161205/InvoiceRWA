{
  "name": "invoicerwa-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "sass assets/scss/styles.scss:assets/css/style.css --no-source-map --style=compressed && npx tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/tailwind.generated.css --minify",
    "build:tailwind": "npx tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/tailwind.generated.css --minify",
    "watch:css": "sass --watch assets/scss/styles.scss:assets/css/style.css",
    "serve": "live-server ./assets --port=5500 --open=pages/login.html",
    "start": "npm run build:css && npm run serve"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "sass": "^1.80.0",
    "tailwindcss": "^3.4.6"
  }
}

