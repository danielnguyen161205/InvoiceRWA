# Database Configuration
DATABASE_URL=mysql+pymysql://user:password@host:port/database

# JWT Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3 Configuration (for document storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=invoice-rwa-documents

# ========================================
# BLOCKCHAIN CONFIGURATION
# ========================================

# Web3 RPC URL
# For Localhost (Hardhat): http://127.0.0.1:8545
# For Sepolia Testnet: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# For Polygon Mainnet: https://polygon-rpc.com
WEB3_RPC_URL=http://127.0.0.1:8545

# Chain ID
# 1337 = Localhost (Hardhat)
# 11155111 = Sepolia Testnet
# 137 = Polygon Mainnet
WEB3_CHAIN_ID=1337

# Smart Contract Address (after deployment)
# Get this from: cd Backend/contracts && npx hardhat run scripts/deploy.js --network localhost
NFT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Backend Admin Wallet Private Key
# This wallet will be used to mint NFTs
# WARNING: NEVER commit this to Git! Keep it secret!
# For Hardhat localhost, you can use one of the test accounts
# Example: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
WEB3_PRIVATE_KEY=your-private-key-here

# Blockchain Explorer (for transaction links)
# For Sepolia: https://sepolia.etherscan.io
# For Polygon: https://polygonscan.com
BLOCKCHAIN_EXPLORER_URL=http://localhost:8545
