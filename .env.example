# ==========================================
# Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=invoicerwa_user
DB_PASSWORD=your_strong_password
DB_NAME=invoicedb

# Or use Aiven Cloud (current setup)
# DB_HOST=mysql-bfd5202-nguyenthai161205-25d3.l.aivencloud.com
# DB_PORT=22740
# DB_USER=avnadmin
# DB_PASSWORD=AVNS_Ulfgj5QiKBfkQbkOBDM
# DB_NAME=invoicedb

# ==========================================
# SECURITY
# ==========================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password hashing algorithm
PASSWORD_HASH_ALGORITHM=bcrypt

# ==========================================
# BLOCKCHAIN CONFIGURATION
# ==========================================

# Ethereum RPC URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Smart Contract Addresses (fill after deployment)
INVOICE_NFT_CONTRACT_ADDRESS=0x...
TOKEN_CONTRACT_ADDRESS=0x...

# Chain ID (31337 for Hardhat local, 11155111 for Sepolia)
CHAIN_ID=31337

# Private key for deployer (DO NOT commit this!)
DEPLOYER_PRIVATE_KEY=0x...

# ==========================================
# AWS S3 CONFIGURATION (for document storage)
# ==========================================

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=invoicerwa-documents

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# API Base URL
API_BASE_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500

# ==========================================
# EMAIL CONFIGURATION (optional)
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@invoicerwa.com

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==========================================
# DEVELOPMENT / PRODUCTION
# ==========================================

ENVIRONMENT=development
DEBUG=True

# ==========================================
# API CONFIGURATION
# ==========================================

API_VERSION=v1
API_TITLE="InvoiceRWA API"
API_DESCRIPTION="Invoice Tokenization Platform API"

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# KYC CONFIGURATION
# ==========================================

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=10

# Allowed file types for documents
ALLOWED_DOCUMENT_TYPES=pdf,jpg,jpeg,png

# KYC verification timeout (in days)
KYC_VERIFICATION_TIMEOUT_DAYS=30
